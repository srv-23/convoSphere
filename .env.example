# Backend Environment Variables
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/convosphere

# JWT & Security (minimum 16 characters; the app refuses to boot otherwise)
JWT_SECRET=your-strong-random-secret-key
# Number of reverse-proxy hops in front of the app. Set to 1 on
# Render/Railway/Fly so rate limiting sees the real client IP. 0 = direct.
TRUST_PROXY=0

# Frontend URL (CORS origin and the link used in emails)
CLIENT_URL=http://localhost:5173

# Resend Email Service (optional: signup works without it)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=your-email@resend.com
EMAIL_FROM_NAME=ConvoSphere

# Cloudinary (optional at boot; required for avatar/image upload)
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Arcjet Rate Limiting (optional: requests pass through when unset)
ARCJET_KEY=your-arcjet-key
ARCJET_ENV=development

# Upload / pagination limits
MAX_IMAGE_BYTES=5242880
MESSAGE_PAGE_SIZE=30

# Optional DNS override for networks that cannot resolve Atlas SRV records.
# Leave empty to use the system resolver.
# DNS_SERVERS=8.8.8.8,8.8.4.4
